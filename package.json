{
  "name": "picforge",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:edgeone": "pnpm build && node deploy/prepare-edgeone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "lint": "oxlint --deny-warnings src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "oxlint": "1.91.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
